{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbita",
  "version": "0.2.0",
  "identifier": "com.orbita.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:9034",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbita",
        "width": 1100,
        "height": 600,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/pdu"]
  }
}